<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\WindowDeck.ico</ApplicationIcon>
    <Version>1.4.1</Version>
    <AssemblyVersion>1.4.1.0</AssemblyVersion>
    <FileVersion>1.4.1.0</FileVersion>
    <InformationalVersion>1.4.1</InformationalVersion>
    <Authors>::BsB!::</Authors>
    <Product>WindowDeck</Product>
    <Description>A lightweight Windows utility for quickly finding and switching between open windows.</Description>
    <Copyright>Copyright (c) 2026 ::BsB!::</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Include="Assets\WindowDeck.ico" LogicalName="WindowDeck.Assets.WindowDeck.ico" />
  </ItemGroup>

</Project>
